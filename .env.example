# Copy to .env (gitignored). Never commit real values.
NEAR_NETWORK=testnet
CASHFLOW_CONTRACT=cashflow.<team>.testnet
USDC_TOKEN=usdc.tidepool-sandbox.testnet
# Underwriter agent (function-call key limited to attest_receipt / set_merchant_tier)
AGENT_ACCOUNT=underwriter.<team>.testnet
AGENT_PRIVATE_KEY=
NEARAI_API_KEY=
NEARAI_MODEL=
# Agent runner (agent/run.mjs). NEAR_RPC defaults to https://test.rpc.fastnear.com
NEAR_RPC=
AGENT_POLL_SECONDS=
AGENT_MAX_INFERENCES=
# Collections agent (agent/collections.mjs). mark_default is callable by anyone after due + grace.
# Key falls back to ~/.near-credentials/testnet/<COLLECTOR_ACCOUNT>.json when COLLECTOR_PRIVATE_KEY is empty.
COLLECTOR_ACCOUNT=
COLLECTOR_PRIVATE_KEY=
# Reminder window before the due date, seconds (default 259200 = 3 days); poll interval (default 30)
COLLECTIONS_WINDOW_SECONDS=
COLLECTIONS_POLL_SECONDS=
# Pay link base; reminder pay_url = <base>/<order_id> (default http://localhost:3000/pay)
PAY_URL_BASE=
# EVM refund address for the reminder's Tidepool quote; empty = reminders without a quote
COLLECTIONS_REFUND_TO=
# 1 = executable (live) Tidepool quotes for the API and collections; anything else = dry
TIDEPOOL_LIVE=
# Meta-tx relayer (relayer/server.mjs). Key falls back to ~/.near-credentials/testnet/<RELAYER_ACCOUNT>.json
RELAYER_ACCOUNT=
RELAYER_PRIVATE_KEY=
RELAYER_PORT=
RELAYER_SPEND_CAP_NEAR=
RELAYER_RATE_LIMIT=
RELAYER_RATE_WINDOW_SEC=
RELAYER_MAX_TTL_BLOCKS=
