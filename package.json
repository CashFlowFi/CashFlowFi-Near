{
  "name": "cashflowfi-near",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test watcher/*.test.mjs agent/*.test.mjs api/*.test.mjs scripts/attacks/*.test.mjs relayer/*.test.mjs",
    "test:contracts": "cd contracts/cashflow-core && cargo test",
    "test:sandbox": "cd contracts/cashflow && cargo test --tests",
    "api": "node --env-file-if-exists=.env api/server.mjs",
    "agent": "node --env-file-if-exists=.env agent/run.mjs",
    "relayer": "node --env-file-if-exists=.env relayer/server.mjs",
    "relay:demo": "node --env-file-if-exists=.env scripts/relay-demo.mjs",
    "forwarder": "node --env-file-if-exists=.env watcher/forwarder.mjs --interval 15",
    "collections": "node --env-file-if-exists=.env agent/collections.mjs",
    "demo": "bash scripts/demo.sh",
    "attacks": "node scripts/attacks/prompt-injection.mjs",
    "attacks:onchain": "node scripts/attacks/onchain.mjs",
    "match": "node --env-file-if-exists=.env scripts/match.mjs",
    "e2e": "node --env-file-if-exists=.env scripts/e2e.mjs"
  },
  "dependencies": {
    "@phala/dcap-qvl": "0.7.0",
    "near-api-js": "7.4.0",
    "viem": "2.57.13"
  }
}
